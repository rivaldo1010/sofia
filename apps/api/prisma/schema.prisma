generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  HOMBRE
  MUJER
  UNISEX
}

enum OrderStatus {
  PENDIENTE
  CONFIRMADO
  PREPARANDO
  ENVIADO
  ENTREGADO
  CANCELADO
}

enum Role {
  CUSTOMER
  ADMIN
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  password  String
  name      String?
  phone     String?
  role      Role       @default(CUSTOMER)
  addresses Address[]
  orders    Order[]
  favorites Favorite[]
  createdAt DateTime   @default(now())
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String
  phone     String
  province  String
  city      String
  address   String
  reference String?
  isDefault Boolean @default(false)
}

model Category {
  id       String    @id @default(cuid())
  name     String
  slug     String
  gender   Gender
  active   Boolean   @default(true)
  products Product[]

  @@unique([slug, gender])
}

model Product {
  id           String      @id @default(cuid())
  name         String
  slug         String      @unique
  description  String
  price        Decimal     @db.Decimal(10, 2)
  comparePrice Decimal?    @db.Decimal(10, 2)
  sku          String      @unique
  brand        String?
  gender       Gender
  categoryId   String
  category     Category    @relation(fields: [categoryId], references: [id])
  images       String[]
  colorImages  Json?
  colors       String[]
  sizes        String[]
  keywords     String[]
  stock        Int         @default(0)
  active       Boolean     @default(true)
  featured     Boolean     @default(false)
  isNew        Boolean     @default(false)
  soldCount    Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  variants     Variant[]
  orderItems   OrderItem[]
  favorites    Favorite[]

  @@index([gender, categoryId, active])
  @@index([featured])
  @@index([soldCount])
}

model Variant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  color     String
  size      String
  stock     Int     @default(0)

  @@unique([productId, color, size])
}

model Order {
  id             String      @id @default(cuid())
  orderNumber    String      @unique
  userId         String?
  user           User?       @relation(fields: [userId], references: [id])
  guestEmail     String?
  fullName       String
  phone          String
  email          String
  province       String
  city           String
  address        String
  reference      String?
  deliveryMethod String
  paymentMethod  String
  status         OrderStatus @default(PENDIENTE)
  subtotal       Decimal     @db.Decimal(10, 2)
  shipping       Decimal     @db.Decimal(10, 2) @default(0)
  total          Decimal     @db.Decimal(10, 2)
  items          OrderItem[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  name      String
  price     Decimal @db.Decimal(10, 2)
  quantity  Int
  color     String
  size      String
  image     String
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Config {
  id              String   @id @default("global")
  whatsappNumber  String?
  whatsappMessage String?
  storeName       String   @default("Sofía")
  currency        String   @default("USD")
  updatedAt       DateTime @updatedAt
}